# Copy to .env and fill in. docker compose and `streamlit run app.py` both read it.

# Required: platform.cominty.ai -> API keys (starts with sk-cmt-)
COMINTY_API_KEY=
# Required: platform.cominty.ai -> avatar -> Profile (starts with user_)
COMINTY_USER_ID=

# Optional
# COMINTY_BASE_URL=https://ds.cominty.com
# COMINTY_AGENT_ID=__cominty_agents::agent.chat
# RUNS_DIR=./runs
